{
  "ConnectionStrings": {
    "SyncDatabase": "Data Source=system-sync-engine.db"
  },

  "SyncEngine": {
    "SyncName": "CustomerSync",
    "DefaultLookbackHours": 24,
    "LogSyncedCustomers": true
  },

  "Retry": {
    "MaxAttempts": 3,
    "BaseDelaySeconds": 2
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}